{
  "@@locale": "en",
  "mTCPTransmissionControlProtocolTransportLayer90c7": "TCP - Transmission Control Protocol\nTransport layer (OSI layer 4)\nTCP (Transmission Control Protocol) provides a connection-oriented, reliable, ordered byte stream using acknowledgements and retransmissions. TCP checks measure whether a target port accepts a connection and how long it takes.",
  "@mTCPTransmissionControlProtocolTransportLayer90c7": {
    "description": "TCP - Transmission Control Protocol\nTransport layer (OSI layer 4)\nTCP (Transmission Control Protocol) provides a connection-oriented, reliable, ordered byte stream using acknowledgements and retransmissions. TCP checks measure whether a target port accepts a connection and how long it takes."
  },
  "mUDPUserDatagramProtocolTransportLayer3546": "UDP - User Datagram Protocol\nTransport layer (OSI layer 4)\nUDP (User Datagram Protocol) sends connectionless datagrams without guaranteeing delivery or ordering. It is used by DNS and real-time media applications. UDP checks send a payload and wait for a reply.",
  "@mUDPUserDatagramProtocolTransportLayer3546": {
    "description": "UDP - User Datagram Protocol\nTransport layer (OSI layer 4)\nUDP (User Datagram Protocol) sends connectionless datagrams without guaranteeing delivery or ordering. It is used by DNS and real-time media applications. UDP checks send a payload and wait for a reply."
  },
  "mICMPInternetControlMessageProtocolNetworkd10d": "ICMP - Internet Control Message Protocol\nNetwork layer (OSI layer 3)\nICMP (Internet Control Message Protocol) carries error and control information for IP networks. Ping uses echo requests and replies to measure round-trip latency and loss; firewall policies can affect replies.",
  "@mICMPInternetControlMessageProtocolNetworkd10d": {
    "description": "ICMP - Internet Control Message Protocol\nNetwork layer (OSI layer 3)\nICMP (Internet Control Message Protocol) carries error and control information for IP networks. Ping uses echo requests and replies to measure round-trip latency and loss; firewall policies can affect replies."
  },
  "mHTTPHTTPSHypertextTransferProtocolApplication316e": "HTTP / HTTPS - Hypertext Transfer Protocol\nApplication layer (OSI layer 7)\nHTTP (Hypertext Transfer Protocol) exchanges web and API resources through requests and responses. HTTPS protects HTTP with TLS and authenticates the server. These checks examine response status, content, timing and certificates.",
  "@mHTTPHTTPSHypertextTransferProtocolApplication316e": {
    "description": "HTTP / HTTPS - Hypertext Transfer Protocol\nApplication layer (OSI layer 7)\nHTTP (Hypertext Transfer Protocol) exchanges web and API resources through requests and responses. HTTPS protects HTTP with TLS and authenticates the server. These checks examine response status, content, timing and certificates."
  },
  "mDNSDomainNameSystemApplicationLayer15b5": "DNS - Domain Name System\nApplication layer (OSI layer 7)\nDNS (Domain Name System) is a distributed naming system for records such as IP addresses and mail servers. Traditional queries use UDP or TCP port 53. DNS checks inspect answers and query time.",
  "@mDNSDomainNameSystemApplicationLayer15b5": {
    "description": "DNS - Domain Name System\nApplication layer (OSI layer 7)\nDNS (Domain Name System) is a distributed naming system for records such as IP addresses and mail servers. Traditional queries use UDP or TCP port 53. DNS checks inspect answers and query time."
  },
  "mMTRRouteDiagnosticsDiagnosticToolMTR3f48": "MTR - Route diagnostics\nDiagnostic tool\nMTR combines route tracing and repeated probes to report replies, latency and loss along a path. It is a diagnostic tool, not a separate protocol; router reply limits can affect its output.",
  "@mMTRRouteDiagnosticsDiagnosticToolMTR3f48": {
    "description": "MTR - Route diagnostics\nDiagnostic tool\nMTR combines route tracing and repeated probes to report replies, latency and loss along a path. It is a diagnostic tool, not a separate protocol; router reply limits can affect its output."
  },
  "mTracerouteRouteTracingDiagnosticToolTraceroute482a": "Traceroute - Route tracing\nDiagnostic tool\nTraceroute infers a route by increasing the IP time-to-live (TTL) and examining replies. It is a diagnostic tool, not a separate protocol, and can use UDP, ICMP or TCP probes.",
  "@mTracerouteRouteTracingDiagnosticToolTraceroute482a": {
    "description": "Traceroute - Route tracing\nDiagnostic tool\nTraceroute infers a route by increasing the IP time-to-live (TTL) and examining replies. It is a diagnostic tool, not a separate protocol, and can use UDP, ICMP or TCP probes."
  },
